#!/usr/bin/env php
<?php

declare(strict_types=1);

use B4x\Edoreczenia\Cli\Application;

(static function (): void {
    $candidates = [
        $GLOBALS['_composer_autoload_path'] ?? null, // set by Composer's bin proxy (Composer 2.2+)
        __DIR__ . '/../../../autoload.php',          // installed as a dependency: vendor/b44x/edoreczenia/bin
        __DIR__ . '/../vendor/autoload.php',         // this repository
    ];

    $loaded = false;
    foreach ($candidates as $autoload) {
        if (is_string($autoload) && is_file($autoload)) {
            require $autoload;
            $loaded = true;

            break;
        }
    }

    if (!$loaded) {
        fwrite(\STDERR, "Composer autoloader not found. Run \"composer install\" first.\n");

        exit(1);
    }

    $argv = is_array($_SERVER['argv'] ?? null) ? array_values(array_filter($_SERVER['argv'], \is_string(...))) : [];

    exit((new Application(\STDOUT, \STDERR))->run($argv));
})();
